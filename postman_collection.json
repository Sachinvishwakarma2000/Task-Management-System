            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Implement JWT Authentication Middleware\",\n  \"description\": \"Add Bearer token validation and user hydration to protected Express routes.\",\n  \"priority\": \"high\",\n  \"status\": \"in-progress\",\n  \"dueDate\": \"2026-10-15T18:00:00.000Z\"\n}"
            },
            "url": {
